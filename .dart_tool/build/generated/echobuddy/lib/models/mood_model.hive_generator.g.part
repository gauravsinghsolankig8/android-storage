// **************************************************************************
// TypeAdapterGenerator
// **************************************************************************

class MoodModelAdapter extends TypeAdapter<MoodModel> {
  @override
  final int typeId = 3;

  @override
  MoodModel read(BinaryReader reader) {
    final numOfFields = reader.readByte();
    final fields = <int, dynamic>{
      for (int i = 0; i < numOfFields; i++) reader.readByte(): reader.read(),
    };
    return MoodModel(
      id: fields[0] as String,
      name: fields[1] as String,
      displayName: fields[2] as String,
      description: fields[3] as String,
      gptPrompt: fields[4] as String,
      iconPath: fields[5] as String,
      colorHex: fields[6] as String,
      animations: (fields[7] as List).cast<String>(),
      voiceStyles: (fields[8] as List).cast<String>(),
      isPro: fields[9] as bool,
      unlockCost: fields[10] as int,
      category: fields[11] as String,
      aiTemperature: fields[12] as double,
      welcomeMessages: (fields[13] as List).cast<String>(),
      idleMessages: (fields[14] as List).cast<String>(),
      behavior: fields[15] as MoodBehavior,
      isActive: fields[16] as bool,
    );
  }

  @override
  void write(BinaryWriter writer, MoodModel obj) {
    writer
      ..writeByte(17)
      ..writeByte(0)
      ..write(obj.id)
      ..writeByte(1)
      ..write(obj.name)
      ..writeByte(2)
      ..write(obj.displayName)
      ..writeByte(3)
      ..write(obj.description)
      ..writeByte(4)
      ..write(obj.gptPrompt)
      ..writeByte(5)
      ..write(obj.iconPath)
      ..writeByte(6)
      ..write(obj.colorHex)
      ..writeByte(7)
      ..write(obj.animations)
      ..writeByte(8)
      ..write(obj.voiceStyles)
      ..writeByte(9)
      ..write(obj.isPro)
      ..writeByte(10)
      ..write(obj.unlockCost)
      ..writeByte(11)
      ..write(obj.category)
      ..writeByte(12)
      ..write(obj.aiTemperature)
      ..writeByte(13)
      ..write(obj.welcomeMessages)
      ..writeByte(14)
      ..write(obj.idleMessages)
      ..writeByte(15)
      ..write(obj.behavior)
      ..writeByte(16)
      ..write(obj.isActive);
  }

  @override
  int get hashCode => typeId.hashCode;

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is MoodModelAdapter &&
          runtimeType == other.runtimeType &&
          typeId == other.typeId;
}

class MoodBehaviorAdapter extends TypeAdapter<MoodBehavior> {
  @override
  final int typeId = 4;

  @override
  MoodBehavior read(BinaryReader reader) {
    final numOfFields = reader.readByte();
    final fields = <int, dynamic>{
      for (int i = 0; i < numOfFields; i++) reader.readByte(): reader.read(),
    };
    return MoodBehavior(
      responseStyle: fields[0] as String,
      gestureFrequency: fields[1] as double,
      movementSpeed: fields[2] as double,
      interactionStyle: fields[3] as String,
      specialActions: (fields[4] as List).cast<String>(),
    );
  }

  @override
  void write(BinaryWriter writer, MoodBehavior obj) {
    writer
      ..writeByte(5)
      ..writeByte(0)
      ..write(obj.responseStyle)
      ..writeByte(1)
      ..write(obj.gestureFrequency)
      ..writeByte(2)
      ..write(obj.movementSpeed)
      ..writeByte(3)
      ..write(obj.interactionStyle)
      ..writeByte(4)
      ..write(obj.specialActions);
  }

  @override
  int get hashCode => typeId.hashCode;

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is MoodBehaviorAdapter &&
          runtimeType == other.runtimeType &&
          typeId == other.typeId;
}
