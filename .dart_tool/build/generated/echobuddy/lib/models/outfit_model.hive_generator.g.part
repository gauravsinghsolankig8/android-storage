class OutfitModelAdapter extends TypeAdapter<OutfitModel> {
  @override
  final int typeId = 5;

  @override
  OutfitModel read(BinaryReader reader) {
    final numOfFields = reader.readByte();
    final fields = <int, dynamic>{
      for (int i = 0; i < numOfFields; i++) reader.readByte(): reader.read(),
    };
    return OutfitModel(
      id: fields[0] as String,
      name: fields[1] as String,
      displayName: fields[2] as String,
      description: fields[3] as String,
      thumbnailUrl: fields[4] as String,
      modelUrl: fields[5] as String,
      category: fields[6] as String,
      coinPrice: fields[7] as int,
      realPrice: fields[8] as double?,
      currency: fields[9] as String,
      isPro: fields[10] as bool,
      isLimited: fields[11] as bool,
      availableUntil: fields[12] as DateTime?,
      tags: (fields[13] as List).cast<String>(),
      rarity: fields[14] as String,
      assets: fields[15] as OutfitAssets,
      isActive: fields[16] as bool,
      unlockCondition: fields[17] as String?,
      compatibleMoods: (fields[18] as List).cast<String>(),
    );
  }

  @override
  void write(BinaryWriter writer, OutfitModel obj) {
    writer
      ..writeByte(19)
      ..writeByte(0)
      ..write(obj.id)
      ..writeByte(1)
      ..write(obj.name)
      ..writeByte(2)
      ..write(obj.displayName)
      ..writeByte(3)
      ..write(obj.description)
      ..writeByte(4)
      ..write(obj.thumbnailUrl)
      ..writeByte(5)
      ..write(obj.modelUrl)
      ..writeByte(6)
      ..write(obj.category)
      ..writeByte(7)
      ..write(obj.coinPrice)
      ..writeByte(8)
      ..write(obj.realPrice)
      ..writeByte(9)
      ..write(obj.currency)
      ..writeByte(10)
      ..write(obj.isPro)
      ..writeByte(11)
      ..write(obj.isLimited)
      ..writeByte(12)
      ..write(obj.availableUntil)
      ..writeByte(13)
      ..write(obj.tags)
      ..writeByte(14)
      ..write(obj.rarity)
      ..writeByte(15)
      ..write(obj.assets)
      ..writeByte(16)
      ..write(obj.isActive)
      ..writeByte(17)
      ..write(obj.unlockCondition)
      ..writeByte(18)
      ..write(obj.compatibleMoods);
  }

  @override
  int get hashCode => typeId.hashCode;

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is OutfitModelAdapter &&
          runtimeType == other.runtimeType &&
          typeId == other.typeId;
}

class OutfitAssetsAdapter extends TypeAdapter<OutfitAssets> {
  @override
  final int typeId = 6;

  @override
  OutfitAssets read(BinaryReader reader) {
    final numOfFields = reader.readByte();
    final fields = <int, dynamic>{
      for (int i = 0; i < numOfFields; i++) reader.readByte(): reader.read(),
    };
    return OutfitAssets(
      glbFile: fields[0] as String,
      textureFiles: (fields[1] as List).cast<String>(),
      animationFiles: (fields[2] as List).cast<String>(),
      materialMappings: (fields[3] as Map).cast<String, String>(),
      normalMapFile: fields[4] as String?,
      roughnessMapFile: fields[5] as String?,
    );
  }

  @override
  void write(BinaryWriter writer, OutfitAssets obj) {
    writer
      ..writeByte(6)
      ..writeByte(0)
      ..write(obj.glbFile)
      ..writeByte(1)
      ..write(obj.textureFiles)
      ..writeByte(2)
      ..write(obj.animationFiles)
      ..writeByte(3)
      ..write(obj.materialMappings)
      ..writeByte(4)
      ..write(obj.normalMapFile)
      ..writeByte(5)
      ..write(obj.roughnessMapFile);
  }

  @override
  int get hashCode => typeId.hashCode;

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is OutfitAssetsAdapter &&
          runtimeType == other.runtimeType &&
          typeId == other.typeId;
}
