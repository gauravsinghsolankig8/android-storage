{
  "name": "saranam-vrindavan-spiritual-guide",
  "version": "1.0.0",
  "description": "Complete full-stack mobile application for Vrindavan spiritual guidance",
  "main": "index.js",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "start": "bash scripts/start-dev.sh",
    "deploy": "bash scripts/deploy.sh",
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npx expo start",
    "admin": "cd admin && npm start",
    "build": "npm run build:backend && npm run build:admin && npm run build:mobile",
    "build:backend": "cd backend && npm ci --only=production",
    "build:admin": "cd admin && npm run build",
    "build:mobile": "cd frontend && npx expo build",
    "test": "npm run test:backend && npm run test:admin && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:admin": "cd admin && npm test",
    "test:frontend": "cd frontend && npm test",
    "clean": "rm -rf node_modules backend/node_modules frontend/node_modules admin/node_modules",
    "install:all": "cd backend && npm install && cd ../frontend && npm install && cd ../admin && npm install",
    "db:setup": "mysql -u root -p saranam_db < db/schema.sql",
    "db:reset": "mysql -u root -p -e 'DROP DATABASE IF EXISTS saranam_db; CREATE DATABASE saranam_db;' && npm run db:setup"
  },
  "keywords": [
    "vrindavan",
    "spiritual",
    "guide",
    "mobile-app",
    "react-native",
    "nodejs",
    "mysql",
    "temple",
    "saints",
    "parikrama",
    "spiritual-journey"
  ],
  "author": "Saranam Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/saranam-vrindavan-spiritual-guide.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/saranam-vrindavan-spiritual-guide/issues"
  },
  "homepage": "https://github.com/your-username/saranam-vrindavan-spiritual-guide#readme",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "workspaces": [
    "backend",
    "frontend",
    "admin"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3"
  }
}